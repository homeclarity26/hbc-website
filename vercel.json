{
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/planning-your-renovation",
      "destination": "/blog/planning-your-renovation.html"
    },
    {
      "source": "/blog/understanding-contractor-bids",
      "destination": "/blog/understanding-contractor-bids.html"
    },
    {
      "source": "/blog/home-advisor-vs-contractor",
      "destination": "/blog/home-advisor-vs-contractor.html"
    },
    {
      "source": "/blog/maintenance-schedule",
      "destination": "/blog/maintenance-schedule.html"
    },
    {
      "source": "/blog/when-to-update-before-selling",
      "destination": "/blog/when-to-update-before-selling.html"
    },
    {
      "source": "/for-trade-partners",
      "destination": "/for-trade-partners.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
